<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns:fx="http://javafx.com/fxml" styleClass="rootContainer">
    <VBox styleClass="backgroundPattern" alignment="CENTER">
        <Circle radius="150" styleClass="decorativeCircle1"/>
        <Region prefHeight="50"/>
        <Circle radius="100" styleClass="decorativeCircle2"/>
        <Region prefHeight="80"/>
        <Circle radius="75" styleClass="decorativeCircle3"/>
    </VBox>

    <VBox styleClass="mainContainer">
        <VBox styleClass="mainCard" spacing="30" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="30" left="40" right="40" top="40"/>
            </padding>

            <VBox alignment="CENTER" spacing="20">
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <Button fx:id="backButton" text="← Voltar" styleClass="backButton"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <Label text="Escolha o Procedimento" styleClass="mainTitle"/>
                <Label text="Selecione os procedimentos necessários para o laboratório" styleClass="subtitle"/>
                <TextField fx:id="searchField" promptText="🔍 Pesquisar procedimentos..."
                           styleClass="searchField"/>
            </VBox>

            <VBox spacing="20" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="Procedimentos Disponíveis" styleClass="sectionTitle"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="resultsCount" text="0 resultados" styleClass="resultsCount"/>
                </HBox>

                <ScrollPane fx:id="proceduresScrollPane"
                            fitToWidth="true"
                            hbarPolicy="NEVER"
                            styleClass="proceduresScrollPane"
                            VBox.vgrow="ALWAYS">
                    <FlowPane fx:id="proceduresContainer"
                              hgap="20"
                              vgap="20"
                              styleClass="proceduresContainer">
                        <padding>
                            <Insets bottom="20" left="5" right="5" top="5"/>
                        </padding>
                    </FlowPane>
                </ScrollPane>
            </VBox>
        </VBox>

        <VBox styleClass="selectedProceduresBar">
            <padding>
                <Insets top="20" right="40" bottom="20" left="40"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label fx:id="selectedCountLabel" text="0 Selecionados" styleClass="selectedCountLabel"/>

                <ScrollPane fx:id="selectedProceduresScrollPane"
                            fitToHeight="true"
                            vbarPolicy="NEVER"
                            styleClass="selectedProceduresScrollPane"
                            HBox.hgrow="ALWAYS">
                    <HBox fx:id="selectedProceduresContainer"
                          spacing="10"
                          alignment="CENTER_LEFT"
                          styleClass="selectedProceduresContainer">
                        <padding>
                            <Insets top="5" right="5" bottom="5" left="5"/>
                        </padding>
                    </HBox>
                </ScrollPane>

                <Button fx:id="continueButton"
                        text="Continuar"
                        styleClass="button"
                        disable="true"/>
            </HBox>
        </VBox>
    </VBox>

</StackPane>