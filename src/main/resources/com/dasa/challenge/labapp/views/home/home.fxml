<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml" alignment="CENTER" spacing="20.0" styleClass="homeMain">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="welcomeText" text="Olá, seja bem-vindo ao SmartLab Inventory!" textAlignment="CENTER"
           styleClass="titleClass"/>
    <Button text="Iniciar Solicitação" alignment="CENTER" fx:id="startWithdrawButton"/>
</VBox>
